NODE_ENV=development # development, production, test
PORT=3000
API_PREFIX=/api

CORS_ORIGINS=http://localhost:3000


DB_HOST=localhost
DB_PORT=5432
DB_USER=replace_with_local_user
DB_PASSWORD=replace_with_local_password
DB_NAME=kinesis
DB_LOGGING=false


JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes
# Token lifetimes in seconds (900 = 15 minutes; 604800 = 7 days)
ACCESS_TOKEN_EXPIRY_TIME=900
REFRESH_TOKEN_EXPIRY_TIME=604800
